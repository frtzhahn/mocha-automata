# Discord Bot Application Credentials
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_client_id_here"

# OpenRouter Inference & Vision Credentials
OPENROUTER_API_KEY="your_openrouter_api_key_here"
LLM_MODEL="openrouter/free"
VISION_MODEL="openrouter/free"
GIPHY_API_KEY="your_optional_key"

# Obsidian Vault Configuration (Path to external vault or default internal ./mocha-vault)
VAULT_DIR="./mocha-vault"

# Multi-channel Log Digestion (Comma-separated channel IDs)
LOG_CHANNELS="your_log_channel_id_here"
